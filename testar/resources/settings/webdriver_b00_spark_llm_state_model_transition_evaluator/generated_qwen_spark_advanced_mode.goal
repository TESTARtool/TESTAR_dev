      "traces": [
        { "name": "Open Settings",
          "originState": { "include": [ { "tag": "WebInnerText", "value": "settings" } ], "exclude": [] },
          "action": { "include": [ { "tag": "Desc", "value": "button_settings" } ], "exclude": [] },
          "targetState": { "include": [ { "tag": "WebInnerText", "value": "Advanced Mode" } ], "exclude": [] }
        },
        { "name": "Open Mode Selector", 
          "originState": { "include": [ { "tag": "WebInnerText", "value": "Advanced Mode" } ], "exclude": [] },
